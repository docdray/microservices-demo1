{
  "title": "Quarkus /hello Endpoint",
  "uid": "quarkus-hello",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Requests pro Sekunde (/hello)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{uri=\"/hello\"}[1m]))",
          "legendFormat": "req/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Gesamtanzahl Zugriffe (/hello)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(http_server_requests_seconds_count{uri=\"/hello\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Durchschnittliche Antwortzeit (/hello)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_sum{uri=\"/hello\"}[1m]) / rate(http_server_requests_seconds_count{uri=\"/hello\"}[1m])",
          "legendFormat": "avg latency (s)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Zugriffe nach Status-Code",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum by (status) (http_server_requests_seconds_count{uri=\"/hello\"})",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Service Status",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
      {
        "expr": "up{job=\"quarkus-app\"}",
        "refId": "A"
      }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
	  { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" } } },
	  { "type": "value", "options": { "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": {
	    "mode": "absolute",
	    "steps": [
	    { "value": 0, "color": "red" },
	    { "value": 1, "color": "green" }
	    ]
          }
        }
      }
    },
    {
  "id": 6,
  "title": "APISIX Status",
  "type": "stat",
  "gridPos": { "h": 4, "w": 6, "x": 0, "y": 16 },
  "datasource": { "type": "prometheus", "uid": "Prometheus" },
  "targets": [{ "expr": "up{job=\"apisix\"}", "refId": "A" }],
  "fieldConfig": {
    "defaults": {
      "mappings": [
        { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" } } },
        { "type": "value", "options": { "1": { "text": "UP", "color": "green" } } }
      ]
    }
  }
},
{
  "id": 7,
  "title": "Postgres Status",
  "type": "stat",
  "gridPos": { "h": 4, "w": 6, "x": 6, "y": 16 },
  "datasource": { "type": "prometheus", "uid": "Prometheus" },
  "targets": [{ "expr": "up{job=\"postgres\"}", "refId": "A" }],
  "fieldConfig": {
    "defaults": {
      "mappings": [
        { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" } } },
        { "type": "value", "options": { "1": { "text": "UP", "color": "green" } } }
      ]
    }
  }
},
{
  "id": 8,
  "title": "APISIX Requests pro Route",
  "type": "timeseries",
  "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
  "datasource": { "type": "prometheus", "uid": "Prometheus" },
  "targets": [
    { "expr": "sum by (route) (rate(apisix_http_status[1m]))", "legendFormat": "{{route}}", "refId": "A" }
  ]
},
{
  "id": 9,
  "title": "APISIX Fehlerhafte Zugriffe (4xx/5xx)",
  "type": "timeseries",
  "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
  "datasource": { "type": "prometheus", "uid": "Prometheus" },
  "targets": [
    { "expr": "sum by (code) (rate(apisix_http_status{code=~\"4..|5..\"}[1m]))", "legendFormat": "HTTP {{code}}", "refId": "A" }
  ]
},
{
  "id": 10,
  "title": "Postgres Zugriffe pro Sekunde",
  "type": "timeseries",
  "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
  "datasource": { "type": "prometheus", "uid": "Prometheus" },
  "targets": [
    { "expr": "rate(pg_stat_database_xact_commit{datname=\"mydatabase\"}[1m]) + rate(pg_stat_database_xact_rollback{datname=\"mydatabase\"}[1m])", "legendFormat": "Transaktionen/s", "refId": "A" }
  ]
},
{
  "id": 11,
  "title": "Postgres Durchschnittliche Query-Zeit",
  "type": "timeseries",
  "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
  "datasource": { "type": "prometheus", "uid": "Prometheus" },
  "targets": [
    { "expr": "sum(rate(pg_stat_statements_seconds_total[5m])) / sum(rate(pg_stat_statements_calls_total[5m]))", "legendFormat": "ø Sekunden pro Query", "refId": "A" }
  ]
}
  ]
}
